{
  "name": "@bps/lab-indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BPS Launch Lab indexer: HTTP-polled launch + swap event indexing into Postgres with cursor resume (Railway service)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/main.js",
    "migrate": "node --enable-source-maps dist/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@sentry/node": "10.68.0",
    "@whetstone-research/doppler-sdk": "1.0.33",
    "pg": "8.16.3",
    "viem": "2.55.8"
  },
  "devDependencies": {
    "@types/pg": "8.15.4"
  }
}
