{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "sourceMap": true,
    "declaration": false,
    // NodeNext: the indexer is a plain-Node ESM service. Its own imports use
    // explicit .js specifiers and it no longer imports @bps/launch-lab at
    // runtime, so it emits cleanly resolvable ESM (see anchors.ts).
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
