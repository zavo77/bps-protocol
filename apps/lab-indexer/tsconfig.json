{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "sourceMap": true,
    "declaration": false,
    // Consume @bps/launch-lab (Bundler-style TS source) the same way apps/web
    // does. Emit preserves the explicit .js specifiers in our own imports, and
    // Node 24 strips the workspace package's types at runtime.
    "module": "esnext",
    "moduleResolution": "bundler",
    // DOM added only so the shared @bps/launch-lab source (which references
    // BlobPart/File in its browser-capable metadata module) type-resolves; the
    // indexer never touches those code paths at runtime.
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
