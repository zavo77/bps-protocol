# Launch Lab local-development defaults — NON-SECRET runtime flags only.
# Secrets (ROBINHOOD_CHAIN_RPC_URL, PINATA_JWT, PINATA_GATEWAY) stay in the
# git-ignored .env.local. Broadcast stays OFF and the kill switch stays ON here;
# production values are set only in Vercel env settings at the launch gate.
BPS_LAUNCH_LAB_ENABLED=true
BPS_LAUNCH_LAB_BROADCAST_ENABLED=false
BPS_LAUNCH_LAB_KILL_SWITCH=true
BPS_LAUNCH_LAB_CREATOR_ALLOWLIST=0x29244A2309B703F82E292A3db7df0e95d0cdca72
BPS_LAUNCH_LAB_BPS_BENEFICIARY=0xF7F2d76F6364c72ea860512d78ae07e54bBbF8A5
BPS_LAUNCH_LAB_START_FDV_USD=20500
BPS_LAUNCH_LAB_DEFAULT_FEE_PRESET=BALANCED_1
