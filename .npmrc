save-exact=true
engine-strict=true
fund=false
audit=false
# @whetstone-research/doppler-sdk declares peerDependencies react ^18 while this
# monorepo is on React 19 (wagmi 3.x supports it). legacy-peer-deps lets npm keep
# the single React 19 instance; all real peers here are explicitly declared.
legacy-peer-deps=true
