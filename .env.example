# BPS Experiment — environment variable template.
# Copy to .env and fill in real values locally. Never commit real values.
# All values below are empty placeholders; nothing here is a working credential.

# ----- Application environment -----
# Runtime environment name: development | test | production
APP_ENV=development
# Port for the web application in local development
PORT=3000

# ----- PostgreSQL -----
# Full PostgreSQL connection string, e.g. postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# Optional separate connection string for migrations (elevated privileges)
DATABASE_MIGRATION_URL=

# ----- Robinhood Chain RPC -----
# HTTPS RPC endpoint URL (provided by the user; do not invent)
ROBINHOOD_CHAIN_RPC_URL=
# Numeric chain ID (provided by the user; verified before any transaction)
ROBINHOOD_CHAIN_ID=

# ----- Wallet authentication -----
# Server-side secret used to sign wallet auth sessions (generate a long random value)
WALLET_AUTH_SESSION_SECRET=
# Domain expected in signed wallet auth messages
WALLET_AUTH_DOMAIN=

# ----- Rialto -----
# Base URL of the Rialto service
RIALTO_API_URL=
# API key for the Rialto service (server-side only)
RIALTO_API_KEY=

# ----- Pilot access -----
# Comma-separated list of wallet addresses allowed into the pilot (provided by the user)
PILOT_ALLOWLIST=
# Invite code required to access pilot features
PILOT_ACCESS_CODE=

# ----- Contract addresses -----
# Deployed contract addresses (filled in only after a real, user-authorized deployment)
BPS_TOKEN_ADDRESS=
BPS_STAKING_ADDRESS=

# ----- Transaction limits -----
# Maximum value per transaction, in whole token units (safety limit enforced server-side)
TX_MAX_VALUE=
# Maximum transactions per wallet per day (safety limit enforced server-side)
TX_MAX_PER_DAY=

# ----- BPS Launch Lab (names only; values live in apps/web/.env.local and Vercel) -----
# Feature gates (fail closed): lab off, broadcast off, kill switch ON unless set
BPS_LAUNCH_LAB_ENABLED=
BPS_LAUNCH_LAB_BROADCAST_ENABLED=
BPS_LAUNCH_LAB_KILL_SWITCH=
# Comma-separated allowlisted creator wallet addresses
BPS_LAUNCH_LAB_CREATOR_ALLOWLIST=
# BPS 10% fee beneficiary address
BPS_LAUNCH_LAB_BPS_BENEFICIARY=
BPS_LAUNCH_LAB_START_FDV_USD=
BPS_LAUNCH_LAB_DEFAULT_FEE_PRESET=
BPS_LAUNCH_LAB_SESSION_SECRET=
# Pinata (server-only; never NEXT_PUBLIC_)
PINATA_JWT=
PINATA_GATEWAY=
# Access mode: disabled | allowlist | public (fail-closed default: allowlist if
# a list exists, else disabled; public is never implied)
BPS_LAUNCH_LAB_ACCESS_MODE=
# Public-beta guardrails (uniform for every wallet)
BPS_LAUNCH_LAB_MAX_LAUNCHES_PER_WALLET=
BPS_LAUNCH_LAB_LAUNCH_COOLDOWN_SECONDS=
BPS_LAUNCH_LAB_PUBLIC_DAILY_LAUNCH_CAP=
BPS_LAUNCH_LAB_METADATA_MAX_BYTES=
BPS_LAUNCH_LAB_REQUEST_TTL_SECONDS=
