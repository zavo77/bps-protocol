# BPS deployment preflight configuration (names only — NEVER commit real values).
#
# These drive DeployBPS.s.sol, which is BROADCAST-FREE: it validates config, resolves the live
# feature-2 Rialto router, computes the deterministic predicted addresses, and writes a sanitized
# manifest. It never signs or broadcasts. The authorized broadcast is a separate step (see
# deploy/RUNBOOK.md) and MUST use a hardware wallet / keystore — never a plaintext private key here.
#
# NEVER place a private key, mnemonic, keystore password, or the Rialto API key in this file or in any
# committed file. RIALTO_API_KEY is consumed only server-side by @bps/rialto/server and is unrelated to
# on-chain deployment. Do not add NEXT_PUBLIC_* variants of any secret.

# --- Deployer identity (deterministic address plan) ---
# The exact deployer account and its CURRENT on-chain nonce at the first (BPSToken) deployment.
BPS_DEPLOYER=
BPS_START_NONCE=

# --- Independently verified Robinhood Chain (4663) externals (see deploy/robinhood-mainnet.dryrun.json) ---
BPS_WETH=
BPS_RIALTO_REGISTRY=
BPS_SWAP_ROUTER_02=
# BPS/WETH Uniswap v3 pool fee tier (e.g. 3000). DEPLOYMENT GATE: the pool itself is unverified.
BPS_POOL_FEE=

# --- Protocol roles / recipients (a Safe is strongly recommended for owner/operator/publisher) ---
BPS_TREASURY=
BPS_PROTOCOL_OWNER=
BPS_RESERVE_RECIPIENT=
BPS_ACQUISITION_OPERATOR=
BPS_ROOT_PUBLISHER=
BPS_CLAIM_RECOVERY=

# --- Approved stock basket (comma-separated addresses; each must have code on chain) ---
BPS_STOCK_BASKET=

# --- Read-only fork RPC used ONLY by the ephemeral mainnet-fork rehearsal (never the production RPC) ---
# Public, rate-limited, read-only. Leave unset to skip the fork rehearsal.
ROBINHOOD_FORK_RPC=
