# guarded-settlement.env.example — TASK 10K-6
# Template for the BROADCAST-FREE guarded-settlement deployment preflight
# (script/settlement/DeployGuardedSettlement.s.sol) and the TypeScript canary preflight
# (packages/rialto canary-preflight-cli). Copy to a local, GITIGNORED .env and fill in.
#
# THIS FILE CONTAINS NO SECRETS AND MUST NEVER CONTAIN ANY.
#   * No private keys, mnemonics, seed phrases, or API keys belong here or in the copied .env.
#   * The Solidity preflight NEVER reads a private key and NEVER broadcasts.
#   * D-24 stands: filling this in authorizes no deployment, funding, approval, or execution.

# ---- Controller / Safe (REQUIRED) ----
# Final deployed-contract controller (e.g. a Gnosis Safe) that will own the executor.
# MUST be a real deployed contract on Robinhood Chain (chainId 4663) — not an EOA, not zero, not 0x...dEaD.
# Left as the zero placeholder here so the preflight FAILS CLOSED until a real controller is supplied.
GS_CONTROLLER=0x0000000000000000000000000000000000000000

# ---- Sequencer uptime feed (OPTIONAL) ----
# No official Robinhood Chain sequencer uptime feed was published as of 2026-07-26, so leave this ZERO.
# The guard mitigates the absence with strict dual-feed freshness (see GS_MAX_*_FEED_AGE_SEC below).
# Only set a nonzero address if an official sequencer feed is later verified.
GS_SEQUENCER_FEED=0x0000000000000000000000000000000000000000
# Grace period (seconds) after sequencer recovery before prices are trusted. Ignored when no feed is set.
GS_SEQUENCER_GRACE_SEC=3600

# ---- Feed freshness policy (REQUIRED; 1..900 seconds) ----
# Maximum accepted age for each Chainlink answer. Stricter than the on-chain heartbeat by design.
# Must be > 0 and <= 900 (the guard/config ceiling). 900 = 15 minutes.
GS_MAX_WETH_FEED_AGE_SEC=900
GS_MAX_NVDA_FEED_AGE_SEC=900

# ---- Canary sell cap (REQUIRED; 1..1000000000000000 wei) ----
# Per-settlement WETH sell ceiling for the private canary. Must be > 0 and <= 1e15 wei (0.001 WETH).
# 1000000000000000 = 0.001 WETH.
GS_CANARY_CAP_WEI=1000000000000000

# ---- Read-only RPC for the TypeScript canary preflight (REQUIRED for that tool only) ----
# A Robinhood Chain (chainId 4663) JSON-RPC endpoint used ONLY for eth_call / eth_getCode reads.
# It is never used to sign or broadcast. Do NOT put credentials in the URL if it is an authenticated
# endpoint — supply such an endpoint only in your local gitignored .env, never commit it.
CANARY_RPC_URL=
