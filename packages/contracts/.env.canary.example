# BPSC-TEST — ROBINHOOD MAINNET CANARY — TEST ONLY (Task 10B-1)
# Canary-only deployment inputs for script/canary/DeployBPSCanary.s.sol. NON-PRODUCTION.
# Copy to `.env.canary` (git-ignored) and fill with PUBLIC ADDRESSES ONLY at authorization time.
# NEVER put a private key, seed phrase, mnemonic, or any secret in this file or the deploy process.
# All values below are intentionally UNSET in the committed template → the script fails closed.
#
# Wallet public addresses (two-wallet minimum; must NOT be a canonical BPS treasury/production/personal wallet):
BPSC_DEPLOYER=            # canary deployer/admin/LP wallet (public address)
BPSC_RECIPIENT=           # full BPSC-TEST supply holder (usually == deployer/LP wallet)
BPSC_OWNER=               # owner of the canary vault + router (pause/two-step only)
BPSC_CONTROLLED_TESTER=   # separate controlled tester wallet (public address)

# Deterministic CREATE plan:
BPSC_START_NONCE=

# External Robinhood-mainnet dependencies (verified in the canary manifest; do not invent):
BPSC_WETH=
BPSC_RIALTO_REGISTRY=
BPSC_SWAP_ROUTER_02=
BPSC_POOL_FEE=            # 10000 for the 1% BPSC/WETH canary pool

# Protocol roles (unresolved founder/counsel inputs — keep fail-closed until authorized):
BPSC_RESERVE_RECIPIENT=
BPSC_ACQUISITION_OPERATOR=
BPSC_ROOT_PUBLISHER=
BPSC_CLAIM_RECOVERY=
BPSC_STOCK_BASKET=        # comma-separated approved stock tokens (unresolved; empty => fail closed)
